<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="RubyDevice.Controls.EnableConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="{x:Bind ConfirmText}"
    CloseButtonText="{x:Bind CancelText}"
    DefaultButton="Primary">

    <StackPanel Spacing="16" MinWidth="340">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Background="{ThemeResource SuccessTintBrush}" CornerRadius="10" Padding="10">
                <FontIcon Glyph="&#xEC92;" FontSize="20" Foreground="{ThemeResource SuccessBrush}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind DialogTitle}" FontSize="17" FontWeight="SemiBold"
                          Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock Text="{x:Bind DeviceName}" FontSize="13"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>
        </StackPanel>

        <!-- Message -->
        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" FontSize="13"
                  Foreground="{ThemeResource TextSecondaryBrush}"/>
    </StackPanel>
</ContentDialog>
