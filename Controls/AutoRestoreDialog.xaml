<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="RubyDevice.Controls.AutoRestoreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="{x:Bind KeepDisabledText}"
    CloseButtonText="{x:Bind RestoreText}"
    DefaultButton="Close">

    <StackPanel Spacing="16" MinWidth="340">
        <!-- Status header -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Background="{ThemeResource WarningTintBrush}" CornerRadius="10" Padding="10">
                <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource WarningBrush}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind DialogTitle}" FontSize="17" FontWeight="SemiBold"
                          Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock Text="{x:Bind DeviceName}" FontSize="13"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          TextWrapping="Wrap" MaxLines="2"/>
            </StackPanel>
        </StackPanel>

        <!-- Countdown -->
        <Border Background="{ThemeResource SuccessTintBrush}" CornerRadius="10" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                <ProgressRing x:Name="CountdownRing" IsIndeterminate="False"
                             Width="46" Height="46"
                             Foreground="{ThemeResource SuccessBrush}"/>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind CountdownLabel}" FontSize="11"
                              Foreground="{ThemeResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="CountdownText" FontSize="26" FontWeight="Bold"
                              Foreground="{ThemeResource SuccessBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Hint -->
        <TextBlock Text="{x:Bind HintText}" TextWrapping="Wrap" FontSize="11"
                  Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
    </StackPanel>
</ContentDialog>
