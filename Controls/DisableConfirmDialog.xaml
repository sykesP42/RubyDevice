<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="RubyDevice.Controls.DisableConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="{x:Bind ConfirmText}"
    CloseButtonText="{x:Bind CancelText}"
    DefaultButton="Primary">

    <StackPanel Spacing="16" MinWidth="340">
        <!-- Warning header -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Background="{ThemeResource DangerTintBrush}" CornerRadius="10" Padding="10">
                <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource DangerBrush}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind DialogTitle}" FontSize="17" FontWeight="SemiBold"
                          Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock Text="{x:Bind DeviceName}" FontSize="13"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>
        </StackPanel>

        <!-- Message -->
        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" FontSize="13"
                  Foreground="{ThemeResource TextSecondaryBrush}" LineHeight="20"/>

        <!-- Countdown -->
        <Border Background="{ThemeResource DangerTintBrush}" CornerRadius="10" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                <ProgressRing x:Name="CountdownRing" IsIndeterminate="False"
                             Width="46" Height="46"
                             Foreground="{ThemeResource DangerBrush}"/>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind CountdownLabel}" FontSize="11"
                              Foreground="{ThemeResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="CountdownText" FontSize="26" FontWeight="Bold"
                              Foreground="{ThemeResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Auto-restore hint -->
        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{ThemeResource SuccessBrush}"/>
            <TextBlock Text="{x:Bind AutoRestoreHint}" FontSize="11"
                      Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
