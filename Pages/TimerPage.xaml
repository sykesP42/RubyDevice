<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="RubyDevice.Pages.TimerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RubyDevice.ViewModels"
    Background="{ThemeResource WindowBackgroundBrush}">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="20">
            <!-- Timer Control -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="24"
                   BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Controls -->
                    <StackPanel Grid.Column="0" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="TimerTitle" FontSize="20" FontWeight="SemiBold"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TimerDesc" FontSize="13" TextWrapping="Wrap"
                                      Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Timer state indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="StateIndicator" Width="8" Height="8" CornerRadius="4"
                                   Background="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimerState" FontSize="13"
                                      Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <NumberBox Grid.Column="0" x:Name="TimeoutBox" Value="30"
                                          Minimum="1" Maximum="480" SpinButtonPlacementMode="Inline"
                                          ValueChanged="TimeoutBox_ValueChanged"/>

                                <Button Grid.Column="1" x:Name="BtnStart" Click="BtnStart_Click"
                                       Padding="16,10" MinWidth="80">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                        <TextBlock x:Name="TextStart"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" x:Name="BtnStop" Click="BtnStop_Click"
                                       Padding="16,10" MinWidth="80" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                        <TextBlock x:Name="TextStop"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Quick Presets -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PresetsTitle" FontSize="12"
                                          Foreground="{ThemeResource TextTertiaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="Preset5" Content="5 min" Padding="12,6" CornerRadius="6"
                                           Click="Preset_Click" Tag="5"/>
                                    <Button x:Name="Preset15" Content="15 min" Padding="12,6" CornerRadius="6"
                                           Click="Preset_Click" Tag="15"/>
                                    <Button x:Name="Preset30" Content="30 min" Padding="12,6" CornerRadius="6"
                                           Click="Preset_Click" Tag="30"/>
                                    <Button x:Name="Preset60" Content="1 hr" Padding="12,6" CornerRadius="6"
                                           Click="Preset_Click" Tag="60"/>
                                    <Button x:Name="Preset120" Content="2 hr" Padding="12,6" CornerRadius="6"
                                           Click="Preset_Click" Tag="120"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Timer Display with progress ring -->
                    <Grid Grid.Column="1" Width="150" Height="150" VerticalAlignment="Center">
                        <ProgressRing x:Name="TimerProgress" IsIndeterminate="False"
                                     Value="30" Maximum="30"
                                     Width="150" Height="150"
                                     Foreground="{ThemeResource PrimaryBrush}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="TimerDisplay" Text="30:00" FontSize="26"
                                      FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TimerUnitText" Text="minutes" FontSize="11"
                                      Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Disabled Devices to Restore -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="20"
                   BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="DisabledTitle" FontSize="18" FontWeight="SemiBold"
                                          Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <Border Grid.Column="1" x:Name="DisabledCountBadge" Background="{ThemeResource DividerBrush}"
                                       CornerRadius="9" Padding="8,2" MinWidth="20"
                                       HorizontalAlignment="Left" Margin="8,0,0,0">
                                    <TextBlock x:Name="DisabledCount" FontSize="11"
                                              Foreground="{ThemeResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="DisabledDesc" FontSize="12"
                                      Foreground="{ThemeResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRestoreAll" Click="BtnRestoreAll_Click"
                               Padding="12,6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                <TextBlock x:Name="TextRestoreAll"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView x:Name="DisabledList" SelectionMode="None" MaxHeight="240">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceViewModel">
                                <Grid Padding="8,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                           Background="{ThemeResource DividerBrush}">
                                        <TextBlock Text="{x:Bind IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="12" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="Medium"
                                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind TypeName, Mode=OneWay}" FontSize="11"
                                                  Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12"
                                              Foreground="{ThemeResource DangerBrush}"
                                              VerticalAlignment="Center"/>

                                    <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                 OnContent="" OffContent=""
                                                 Toggled="ToggleSwitch_Toggled"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
