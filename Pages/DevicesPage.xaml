<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="RubyDevice.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RubyDevice.ViewModels"
    Background="{ThemeResource WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="16,10" Background="{ThemeResource HeaderBackgroundBrush}"
               BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="10">
                <!-- First row: Filters -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="FilterAll" GroupName="Filter" IsChecked="True"
                                Click="Filter_Click" Tag="All">
                        <TextBlock x:Name="TextFilterAll"/>
                    </RadioButton>
                    <RadioButton x:Name="FilterKeyboard" GroupName="Filter" Click="Filter_Click" Tag="Keyboard">
                        <TextBlock x:Name="TextKeyboard"/>
                    </RadioButton>
                    <RadioButton x:Name="FilterMouse" GroupName="Filter" Click="Filter_Click" Tag="Mouse">
                        <TextBlock x:Name="TextMouse"/>
                    </RadioButton>
                    <RadioButton x:Name="FilterTouchpad" GroupName="Filter" Click="Filter_Click" Tag="Touchpad">
                        <TextBlock x:Name="TextTouchpad"/>
                    </RadioButton>

                    <Border Width="1" Height="20" Background="{ThemeResource DividerBrush}" Margin="8,0"/>

                    <!-- Status Filter -->
                    <RadioButton x:Name="StatusAll" GroupName="Status" IsChecked="True"
                                Click="StatusFilter_Click" Tag="All">
                        <TextBlock x:Name="TextStatusAll"/>
                    </RadioButton>
                    <RadioButton x:Name="StatusEnabled" GroupName="Status"
                                Click="StatusFilter_Click" Tag="Enabled">
                        <TextBlock x:Name="TextStatusEnabled"/>
                    </RadioButton>
                    <RadioButton x:Name="StatusDisabled" GroupName="Status"
                                Click="StatusFilter_Click" Tag="Disabled">
                        <TextBlock x:Name="TextStatusDisabled"/>
                    </RadioButton>
                </StackPanel>

                <!-- Second row: Search + Actions -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <AutoSuggestBox Grid.Column="0" x:Name="SearchBox"
                                    QuerySubmitted="SearchBox_QuerySubmitted"
                                    TextChanged="SearchBox_TextChanged"
                                    Height="32"/>

                    <!-- Sort -->
                    <ComboBox Grid.Column="1" x:Name="SortCombo" SelectedIndex="0"
                              SelectionChanged="SortCombo_SelectionChanged"
                              Height="32" MinWidth="120">
                        <ComboBoxItem><TextBlock x:Name="SortByName"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock x:Name="SortByType"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock x:Name="SortByStatus"/></ComboBoxItem>
                    </ComboBox>

                    <!-- Activity Highlight Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TextActivityHighlight" FontSize="12"
                                  Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="ActivityHighlightToggle" IsOn="True"
                                     Toggled="ActivityHighlight_Toggled" OnContent="" OffContent=""/>
                    </StackPanel>

                    <!-- Refresh -->
                    <Button Grid.Column="3" x:Name="BtnRefresh" Click="BtnRefresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock x:Name="TextRefresh"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Devices List -->
        <ScrollViewer Grid.Row="1" Padding="16,12">
            <StackPanel Spacing="12">
                <!-- Device count -->
                <TextBlock x:Name="TextDeviceCount" FontSize="12"
                          Foreground="{ThemeResource TextSecondaryBrush}" Visibility="Collapsed"/>

                <!-- Empty state -->
                <StackPanel x:Name="TextNoDevices" HorizontalAlignment="Center" Margin="0,56"
                           Visibility="Collapsed" Spacing="10">
                    <FontIcon Glyph="&#xE772;" FontSize="34" Foreground="{ThemeResource TextTertiaryBrush}"
                             HorizontalAlignment="Center"/>
                    <TextBlock FontSize="13" Foreground="{ThemeResource TextTertiaryBrush}"
                              HorizontalAlignment="Center" x:Name="EmptyStateText"/>
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.DeviceGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceGroupViewModel">
                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                <!-- Group Header -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                              FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold"
                                              Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="{ThemeResource DividerBrush}" CornerRadius="9"
                                           Padding="8,1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind CountText}" FontSize="11"
                                                  Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Button Grid.Column="4" Content="{x:Bind EnableAllText}"
                                           Click="BtnEnableAll_Click" Tag="{x:Bind Type}"
                                           Padding="8,4" FontSize="11" MinWidth="0"
                                           Visibility="{x:Bind HasDisabled}"/>
                                    <Button Grid.Column="5" Content="{x:Bind DisableAllText}"
                                           Click="BtnDisableAll_Click" Tag="{x:Bind Type}"
                                           Padding="8,4" FontSize="11" MinWidth="0"
                                           Visibility="{x:Bind HasEnabled}"/>
                                </Grid>

                                <!-- Devices -->
                                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8"
                                       Padding="12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                    <ItemsControl ItemsSource="{x:Bind Devices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeviceViewModel">
                                                <Border PointerPressed="Device_Click" Tag="{x:Bind}"
                                                       RightTapped="Device_RightTapped" Loaded="DeviceRow_Loaded"
                                                       Unloaded="DeviceRow_Unloaded"
                                                       Background="{x:Bind ActiveBrush, Mode=OneWay}"
                                                       CornerRadius="8" Padding="12,10"
                                                       Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Type icon tile -->
                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                                                               Background="{ThemeResource DividerBrush}"
                                                               VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind IconGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets"
                                                                      FontSize="16" Foreground="{x:Bind TypeIconBrush, Mode=OneWay}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Device Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"
                                                                          TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                                <!-- Live input pulse dot -->
                                                                <Ellipse x:Name="ActiveDot" Width="7" Height="7"
                                                                        Fill="{ThemeResource SuccessBrush}"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{x:Bind IsActiveDotVisibility, Mode=OneWay}"
                                                                        ToolTipService.ToolTip="{x:Bind ActivityHint}"/>
                                                                <!-- Note indicator -->
                                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                                          FontSize="10" Foreground="{ThemeResource TextTertiaryBrush}"
                                                                          Visibility="{x:Bind HasNote, Mode=OneWay}"
                                                                          ToolTipService.ToolTip="{x:Bind HasNoteText}"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind LocationText, Mode=OneWay}" FontSize="12"
                                                                          Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{x:Bind UsageTimeText, Mode=OneWay}" FontSize="12"
                                                                          Foreground="{ThemeResource TextTertiaryBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Status pill -->
                                                        <Border Grid.Column="2" Background="{x:Bind StatusPillBrush, Mode=OneWay}"
                                                               CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Ellipse Width="6" Height="6" Fill="{x:Bind StatusDotBrush, Mode=OneWay}"
                                                                        VerticalAlignment="Center"/>
                                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11"
                                                                          Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Toggle -->
                                                        <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                    OnContent="" OffContent=""
                                                                    Toggled="ToggleSwitch_Toggled"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
