<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RubyDevice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar: drag region only; the system caption buttons render on the
             right side of this area -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{ThemeResource HeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <!-- App icon tile + name -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" Spacing="9">
                <Border Width="24" Height="24" CornerRadius="7" Background="{ThemeResource PrimaryBrush}">
                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                              Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="RubyDevice" FontSize="12" FontWeight="SemiBold"
                          VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="{ThemeResource SidebarBackgroundBrush}"
                 BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Navigation -->
                <ListView Grid.Row="0" x:Name="NavList" SelectionMode="Single"
                         SelectionChanged="NavList_SelectionChanged" Background="Transparent"
                         Padding="10,8" Margin="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="42"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Margin" Value="4,2"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem x:Name="NavItemDevices" Tag="Devices" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconDevices" Glyph="&#xE765;" FontSize="17"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextDevices" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemUsageRecord" Tag="UsageRecord" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconUsageRecord" Glyph="&#xE787;" FontSize="17"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextUsageRecord" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemStatistics" Tag="Statistics" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconStatistics" Glyph="&#xE9D9;" FontSize="17"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextStatistics" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemTimer" Tag="Timer" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconTimer" Glyph="&#xE916;" FontSize="17"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextTimer" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemSettings" Tag="Settings" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconSettings" Glyph="&#xE713;" FontSize="17"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextSettings" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemAbout" Tag="About" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconAbout" Glyph="&#xE946;" FontSize="17"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextAbout" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <!-- Footer -->
                <Border Grid.Row="1" Padding="14,10" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.1.0" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Column="1" Background="{ThemeResource WindowBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="24,18,24,14">
                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle" FontSize="22" FontWeight="SemiBold"
                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="HeaderSubtitle" FontSize="12" Margin="0,3,0,0"
                                  Foreground="{ThemeResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Page Frame -->
                <Frame x:Name="ContentFrame" Grid.Row="1"/>

                <!-- In-app notification banner -->
                <InfoBar x:Name="NotificationBar" Grid.Row="1" IsOpen="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="24,6,24,0"
                        CornerRadius="8"
                        CloseButtonClick="NotificationBar_CloseClick"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
