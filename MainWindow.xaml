<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RubyDevice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar: drag region only; the system caption buttons render on the
             right side of this area -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{ThemeResource HeaderBackgroundBrush}"
              BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <!-- App Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                <TextBlock Text="&#xE96E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                          VerticalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}"/>
                <TextBlock Text="RubyDevice" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                          VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="{ThemeResource SidebarBackgroundBrush}"
                 BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Navigation -->
                <ListView Grid.Row="0" x:Name="NavList" SelectionMode="Single"
                         SelectionChanged="NavList_SelectionChanged" Background="Transparent"
                         Padding="8" Margin="0">
                    <ListViewItem x:Name="NavItemDevices" Tag="Devices" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconDevices" Glyph="&#xE765;" FontSize="16"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextDevices" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemUsageRecord" Tag="UsageRecord" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconUsageRecord" Glyph="&#xE787;" FontSize="16"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextUsageRecord" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemStatistics" Tag="Statistics" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconStatistics" Glyph="&#xE9D9;" FontSize="16"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextStatistics" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemTimer" Tag="Timer" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconTimer" Glyph="&#xE916;" FontSize="16"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextTimer" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemSettings" Tag="Settings" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconSettings" Glyph="&#xE713;" FontSize="16"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextSettings" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavItemAbout" Tag="About" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="IconAbout" Glyph="&#xE946;" FontSize="16"
                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TextAbout" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <!-- Footer -->
                <Border Grid.Row="1" Padding="16,12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"/>
                </Border>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Column="1" Background="{ThemeResource WindowBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,16" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle" FontSize="20" FontWeight="Bold"
                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="HeaderSubtitle" FontSize="12" Margin="0,2,0,0"
                                  Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Page Frame -->
                <Frame x:Name="ContentFrame" Grid.Row="1"/>

                <!-- In-app notification banner -->
                <InfoBar x:Name="NotificationBar" Grid.Row="1" IsOpen="False"
                        VerticalAlignment="Top" Margin="16,8,16,0"
                        CloseButtonClick="NotificationBar_CloseClick"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
